# Security headers for all routes. Served verbatim by Cloudflare Pages.
# See also the zone-level hardening (DNSSEC, SPF/DMARC, HSTS preload, CAA) that
# lives in the Cloudflare dashboard, not here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # The 'unsafe-inline' tokens below are placeholders: the post-build step
  # scripts/csp-hashes.mjs replaces script-src's with the sha256 of each inline
  # <script> in dist/ and drops style-src's entirely (the site ships no inline
  # styles). If that step is ever skipped, the policy degrades safely to the
  # working inline-permitting one rather than breaking the page.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Long-cache the content-hashed build assets (safe: filenames change on change).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Résumé PDFs: refresh daily, but serve a stale copy for a week while revalidating.
/cv/*.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Static single assets (favicon, OG image) that change rarely.
/favicon.svg
  Cache-Control: public, max-age=86400
/profile.jpg
  Cache-Control: public, max-age=86400
