---
import { news } from "../data/news";
import { talks } from "../data/talks";
import { inline, monthYear } from "../utils/text";

// The feed shows items from January 2024 onwards only.
const SINCE = "2024-01-01";

// Strip the mini-syntax's structural characters from CV-sourced strings so a
// stray brace/pipe can't break the {label|href} expansion below.
const clean = (s: string) => s.replace(/[{}|]/g, "").trim();

// Fold the CV's invited talks into the feed as prose items, phrased with the
// same {label|href} mini-syntax the hand-written news uses (linked title when a
// slides URL exists). These merge and sort in with the manual updates.
const talkItems = talks.map((t) => {
  const title = clean(t.title);
  const linked = t.slides ? `{${title}|${t.slides}}` : `“${title}”`;
  const where = t.venue ? ` at ${clean(t.venue)}` : "";
  return { date: t.date, text: `**Invited talk** — ${linked}${where}.` };
});

const feed = [...news, ...talkItems]
  .filter((item) => item.date >= SINCE)
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
---

<section id="news" class="section" aria-label="News">
  <div class="wrap">
    <p class="eyebrow"><span class="em">📰</span>News And Updates</p>

    <ol class="feed">
      {feed.map((item) => (
        <li class="item">
          <time class="date mono" datetime={item.date}>{monthYear(item.date)}</time>
          <p class="prose text" set:html={inline(item.text)} />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .feed { list-style: none; margin: 0; padding: 0; }
  .item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: 1rem;
    align-items: baseline;
  }
  .item + .item { border-top: 1px solid var(--rule); }
  /* Bold + darker, matching the CV page's left date column. */
  .date { font-size: 0.78rem; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .text { font-size: 0.98rem; }

  @media (max-width: 520px) {
    .item { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
