---
import { news } from "../data/news";
import { inline, monthYear } from "../utils/text";
---

<section id="news" class="section" aria-label="News">
  <div class="wrap">
    <p class="eyebrow"><span class="em">📰</span>News</p>
    <h2 class="section-title">Recent updates.</h2>

    <ol class="feed">
      {news.map((item) => (
        <li class="item">
          <time class="date mono" datetime={item.date}>{monthYear(item.date)}</time>
          <p class="prose text" set:html={inline(item.text)} />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .feed { list-style: none; margin: 0; padding: 0; }
  .item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: 1rem;
    align-items: baseline;
  }
  .item + .item { border-top: 1px solid var(--rule); }
  .date { font-size: 0.78rem; color: var(--faint); white-space: nowrap; }
  .text { font-size: 0.98rem; }

  @media (max-width: 520px) {
    .item { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
