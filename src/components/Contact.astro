---
import { site } from "../data/site";
---

<section id="contact" class="section contact" aria-label="Contact">
  <div class="wrap">
    <p class="eyebrow"><span class="em">✉️</span>Contact</p>
    <p class="prose lede">
      I'm always glad to talk about code models, verifiers, and long-horizon
      agents — or to hear about roles and collaborations. Reach me by email, or
      find me on the profiles linked at the top of the page.
    </p>

    <div class="actions">
      <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href="/cv">View CV</a>
      <a class="btn" href="/cv/indraneil-paul-cv.pdf" target="_blank" rel="noopener">Download CV (PDF)</a>
    </div>
  </div>
</section>

<style>
  /* Full section width, justified to match the other text blocks. */
  .lede { color: var(--muted); text-align: justify; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.82rem;
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .btn:hover { border-color: var(--accent); background: var(--wash); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn.primary:hover { background: var(--accent-hover); color: #fff; }

  /* On narrow screens: email on its own row, the two CV buttons sharing the next. */
  @media (max-width: 560px) {
    .actions .btn { text-align: center; }
    .actions .btn.primary { flex: 1 0 100%; }
    .actions .btn:not(.primary) { flex: 1 1 0; }
  }
</style>
