---
import { site, socials } from "../data/site";

const primary = socials.filter((s) =>
  ["Email", "Google Scholar", "GitHub"].includes(s.label)
);
---

<section id="contact" class="section contact" aria-label="Contact">
  <div class="wrap">
    <p class="eyebrow"><span class="em">✉️</span>Contact</p>
    <h2 class="section-title">Get in touch.</h2>
    <p class="prose lede">
      I'm always glad to talk about code models, verifiers, and long-horizon
      agents — or to hear about roles and collaborations. Reach me by email, or
      find me on the profiles below.
    </p>

    <div class="actions">
      <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href="/cv">View CV</a>
      <a class="btn" href="/cv/indraneil-paul-cv.pdf" target="_blank" rel="noopener">Download CV (PDF)</a>
    </div>

    <ul class="links">
      {socials
        .filter((s) => !s.href.startsWith("mailto:"))
        .map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
          </li>
        ))}
    </ul>
  </div>
</section>

<style>
  .lede { max-width: 38rem; color: var(--muted); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.82rem;
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .btn:hover { border-color: var(--accent); background: var(--wash); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn.primary:hover { background: var(--accent-hover); color: #fff; }

  .links {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .links a { color: var(--muted); text-decoration: none; transition: color 0.18s var(--ease); }
  .links a:hover { color: var(--accent); }
</style>
