---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  /** when true, section links resolve to "/#id" (used on sub-pages like /cv) */
  absolute?: boolean;
}
const { absolute = false } = Astro.props;
const base = absolute ? "/" : "";
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href={absolute ? "/" : "#top"}>
      <span class="brand-mark">ip</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="links" aria-label="Sections">
      {nav.map((item) => (
        <a href={`${base}#${item.id}`}>{item.label}</a>
      ))}
      <a href={absolute ? "/cv" : "/cv"} class="cv-link">CV</a>
    </nav>

    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Switch to dark theme"
      aria-pressed="false"
      title="Toggle light / dark theme"
    >
      <span class="ico ico-moon" aria-hidden="true"><Icon name="moon" /></span>
      <span class="ico ico-sun" aria-hidden="true"><Icon name="sun" /></span>
    </button>

    <button type="button" class="cmdk" data-open-palette aria-label="Open command palette">
      <span class="cmdk-key">⌘</span><span class="cmdk-key">K</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(50px);
    -webkit-backdrop-filter: saturate(1.4) blur(50px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .nav[data-scrolled] { border-bottom-color: var(--rule); }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .brand-mark {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.03em;
    color: var(--on-accent);
    background: var(--accent);
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
  }
  /* line-height: 1 collapses the serif's tall line box so the name's glyphs
     sit on the same optical centre as the square mark (flex align-items: center
     centres the boxes, not the ink). */
  .brand-name { font-family: var(--serif); font-weight: 600; font-size: 1.02rem; line-height: 1; letter-spacing: -0.01em; }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.4rem);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .links a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    padding-block: 0.25rem;
    position: relative;
    transition: color 0.18s var(--ease);
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease);
  }
  .links a:hover { color: var(--ink); }
  .links a:hover::after { transform: scaleX(1); }
  .cv-link { color: var(--accent-bright) !important; }

  /* Theme toggle — same chip treatment as the ⌘K button, sized as a square that
     matches the brand mark (1.7rem) for a consistent nav row. Shows a moon in
     light (→ dark) and a sun in dark (→ light); the swap is keyed off the root's
     data-theme so it needs no per-click JS. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    color: var(--muted);
    background: var(--bg-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle :global(.icon) { font-size: 0.95rem; }
  .theme-toggle .ico { display: inline-flex; }
  .theme-toggle .ico-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .ico-moon { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .ico-sun { display: inline-flex; }

  .cmdk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.05rem;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--bg-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .cmdk:hover { border-color: var(--accent); color: var(--accent); }
  .cmdk-key { line-height: 1; }

  /* On narrow screens the text links don't fit; the ⌘K palette button (always
     visible) carries section navigation instead. */
  @media (max-width: 640px) {
    .links { display: none; }
    .brand-name { font-size: 0.98rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<script>
  // Theme toggle. The pre-paint inline script in Base.astro has already set
  // <html data-theme> from localStorage; here we wire the buttons, keep the
  // <meta name="theme-color"> and each toggle's a11y state in sync, and persist
  // the choice. Light is the default (attribute simply absent). Any element with
  // [data-theme-toggle] participates (nav button, ⌘K palette command).
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const toggles = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
  );

  const apply = (theme: "light" | "dark") => {
    if (theme === "dark") root.dataset.theme = "dark";
    else delete root.dataset.theme;
    if (meta) meta.setAttribute("content", theme === "dark" ? "#151916" : "#004225");
    toggles.forEach((b) => {
      b.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
      );
      b.setAttribute("aria-pressed", String(theme === "dark"));
    });
  };

  // Reconcile button state with whatever the pre-paint script decided.
  apply(root.dataset.theme === "dark" ? "dark" : "light");

  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        /* private mode / storage disabled — theme still applies for this page */
      }
      apply(next);
    })
  );
</script>
