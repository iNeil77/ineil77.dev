---
import { site, nav } from "../data/site";

interface Props {
  /** when true, section links resolve to "/#id" (used on sub-pages like /cv) */
  absolute?: boolean;
}
const { absolute = false } = Astro.props;
const base = absolute ? "/" : "";
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href={absolute ? "/" : "#top"}>
      <span class="brand-mark">ip</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="links" aria-label="Sections">
      {nav.map((item) => (
        <a href={`${base}#${item.id}`}>{item.label}</a>
      ))}
      <a href={absolute ? "/cv" : "/cv"} class="cv-link">CV</a>
    </nav>

    <button type="button" class="cmdk" data-open-palette aria-label="Open command palette">
      <span class="cmdk-key">⌘</span><span class="cmdk-key">K</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(150px);
    -webkit-backdrop-filter: saturate(1.4) blur(150px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .nav[data-scrolled] { border-bottom-color: var(--rule); }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .brand-mark {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.03em;
    color: #fff;
    background: var(--accent);
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
  }
  /* line-height: 1 collapses the serif's tall line box so the name's glyphs
     sit on the same optical centre as the square mark (flex align-items: center
     centres the boxes, not the ink). */
  .brand-name { font-family: var(--serif); font-weight: 600; font-size: 1.02rem; line-height: 1; letter-spacing: -0.01em; }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.4rem);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .links a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    padding-block: 0.25rem;
    position: relative;
    transition: color 0.18s var(--ease);
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease);
  }
  .links a:hover { color: var(--ink); }
  .links a:hover::after { transform: scaleX(1); }
  .cv-link { color: var(--accent-bright) !important; }

  .cmdk {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0.3rem 0.5rem;
    cursor: pointer;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .cmdk:hover { border-color: var(--accent); color: var(--accent); }
  .cmdk-key { line-height: 1; }

  /* On narrow screens the text links don't fit; the ⌘K palette button (always
     visible) carries section navigation instead. */
  @media (max-width: 640px) {
    .links { display: none; }
    .brand-name { font-size: 0.98rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
