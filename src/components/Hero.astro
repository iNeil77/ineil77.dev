---
import { site, bio, socials, status } from "../data/site";
import { inline } from "../utils/text";
import Icon from "./Icon.astro";

// Maps each profile to its brand mark + brand colour (used to tint the label
// on hover). Hugging Face renders as its full-colour official logo, so its
// colour here only sets the amber hover tint to match.
const brand: Record<string, { icon: string; color: string }> = {
  Scholar: { icon: "scholar", color: "#4285F4" },
  GitHub: { icon: "github", color: "#24292F" },
  HuggingFace: { icon: "huggingface", color: "#FF9D00" },
  LinkedIn: { icon: "linkedin", color: "#0A66C2" },
};

// Email and X live elsewhere (email in the Contact section; both stay in the
// ⌘K palette), so they're kept out of the hero's profile row.
const HIDE_IN_ROW = new Set(["Email", "X"]);
const heroSocials = socials.filter((s) => !HIDE_IN_ROW.has(s.label));
---

<section id="about" class="section hero" aria-label="About">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="name">{site.name}</h1>
      <p class="role">{site.role}</p>

      <div class="prose bio">
        {bio.map((para) => (
          <p set:html={inline(para)} />
        ))}
      </div>

      <ul class="socials" aria-label="Profiles and contact">
        {heroSocials.map((s) => {
          const b = brand[s.label];
          return (
            <li>
              <a
                href={s.href}
                class="social"
                style={b ? `--brand: ${b.color}` : undefined}
                target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={s.href.startsWith("mailto:") ? undefined : "noopener"}
              >
                {b && <Icon name={b.icon} />}
                <span class="social-label">{s.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="hero-photo">
      <img
        src="/profile.jpg"
        alt={`Portrait of ${site.name}`}
        width="320"
        height="320"
        loading="eager"
        decoding="async"
      />
      <p class="location">
        <span class="pin" aria-hidden="true">{status.emoji}</span>{status.text}
      </p>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 7vw, 4.5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 13rem);
    gap: clamp(1.75rem, 5vw, 2.75rem);
    align-items: start;
  }
  .hero-text { min-width: 0; }

  .location {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .pin { font-size: 0.95em; }

  .name {
    font-size: clamp(2.25rem, 6vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .role {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .bio { margin-top: 1.6rem; text-align: justify; }
  .bio p + p { margin-top: 1rem; }

  .socials {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.6rem;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--ink);
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    transition: color 0.18s var(--ease), background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .social :global(.icon) { font-size: 1.15rem; color: var(--brand, var(--accent)); }
  .social-label {
    font-size: 0.9rem;
    font-variant-caps: small-caps;
    font-synthesis: small-caps;
    letter-spacing: 0.03em;
  }
  .social:hover { color: var(--brand, var(--accent)); background: var(--wash); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) {
    .social { transition: color 0.18s var(--ease), background 0.18s var(--ease); }
    .social:hover { transform: none; }
  }

  .hero-photo {
    position: sticky;
    top: 5rem;
  }
  .hero-photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--wash);
    box-shadow: 0 20px 45px -24px rgba(0, 66, 37, 0.4);
  }

  @media (max-width: 720px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo {
      position: static;
      order: -1;
      justify-self: start;
    }
    .hero-photo img { width: clamp(6.5rem, 34vw, 9rem); }
    .location { justify-content: flex-start; }
  }
</style>
