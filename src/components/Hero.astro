---
import { site, bio, socials, status } from "../data/site";
import { inline } from "../utils/text";
---

<section id="about" class="section hero" aria-label="About">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="status">
        <span class="dot" aria-hidden="true">{status.emoji}</span>
        <span class="status-text">{status.text}</span>
      </p>
      <h1 class="name">{site.name}</h1>
      <p class="role">{site.role}</p>

      <div class="prose bio">
        {bio.map((para) => (
          <p set:html={inline(para)} />
        ))}
      </div>

      <ul class="socials" aria-label="Profiles and contact">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="social"
              target={s.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={s.href.startsWith("mailto:") ? undefined : "noopener"}
            >
              <span class="social-label">{s.label}</span>
              {s.handle && <span class="social-handle">{s.handle}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-photo">
      <img
        src="/profile.jpg"
        alt={`Portrait of ${site.name}`}
        width="320"
        height="320"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 7vw, 4.5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 13rem);
    gap: clamp(1.75rem, 5vw, 2.75rem);
    align-items: start;
  }
  .hero-text { min-width: 0; }

  .status {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    max-width: 100%;
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--accent);
    background: var(--wash);
    border: 1px solid var(--wash-strong);
    border-radius: 14px;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    margin-bottom: 1.1rem;
  }
  .status-text { min-width: 0; }
  .dot { font-size: 0.8rem; flex: none; }

  .name {
    font-size: clamp(2.25rem, 6vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .role {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .bio { margin-top: 1.6rem; }
  .bio p + p { margin-top: 1rem; }

  .socials {
    list-style: none;
    padding: 0;
    margin: 1.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .social {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0.35rem 0.7rem;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .social:hover { border-color: var(--accent); background: var(--wash); }
  .social-label { font-size: 0.85rem; color: var(--ink); }
  .social-handle { font-family: var(--mono); font-size: 0.7rem; color: var(--faint); }

  .hero-photo {
    position: sticky;
    top: 5rem;
  }
  .hero-photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--wash);
    box-shadow: 0 20px 45px -24px rgba(0, 66, 37, 0.4);
  }

  @media (max-width: 720px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo {
      position: static;
      order: -1;
      justify-self: start;
      width: clamp(6.5rem, 34vw, 9rem);
    }
  }
</style>
