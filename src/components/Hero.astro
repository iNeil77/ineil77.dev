---
import { Picture } from "astro:assets";
import { site, bio, socials, status } from "../data/site";
import { inline } from "../utils/text";
import Icon from "./Icon.astro";
import profileImg from "../assets/profile.jpg";

// Maps each profile to its brand mark. The matching brand colour (used to tint
// the label + icon on hover) lives in CSS, keyed off the `data-brand` attribute
// below — see the `.social[data-brand=…]` rules.
const brand: Record<string, { icon: string }> = {
  Scholar: { icon: "scholar" },
  GitHub: { icon: "github" },
  HuggingFace: { icon: "huggingface" },
  LinkedIn: { icon: "linkedin" },
};

// Email and X live elsewhere (email in the Contact section; both stay in the
// ⌘K palette), so they're kept out of the hero's profile row.
const HIDE_IN_ROW = new Set(["Email", "X"]);
const heroSocials = socials.filter((s) => !HIDE_IN_ROW.has(s.label));
---

<section id="about" class="section hero" aria-label="About">
  <div class="wrap hero-grid">
    <div class="hero-head">
      <h1 class="name">{site.name}</h1>
      <p class="role">{site.role}</p>
    </div>

    <div class="hero-photo">
      <Picture
        src={profileImg}
        formats={["avif", "webp"]}
        widths={[320, 640]}
        sizes="(max-width: 720px) 55vw, 208px"
        quality={88}
        alt={`Portrait of ${site.name}`}
        loading="eager"
        decoding="async"
      />
      <p class="location">
        <span class="pin" aria-hidden="true">{status.emoji}</span>{status.text}
      </p>
    </div>

    <div class="hero-body">
      <div class="prose bio">
        {bio.map((para) => (
          <p set:html={inline(para)} />
        ))}
      </div>

      <ul class="socials" aria-label="Profiles and contact">
        {heroSocials.map((s) => {
          const b = brand[s.label];
          return (
            <li>
              <a
                href={s.href}
                class="social"
                data-brand={b ? b.icon : undefined}
                target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={s.href.startsWith("mailto:") ? undefined : "noopener"}
              >
                {b && <Icon name={b.icon} />}
                <span class="social-label">{s.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Bottom padding stays the full --section-gap so the bio→Research Interests
     gap is preserved even though the other sections use the tighter rhythm. */
  .hero { padding-top: clamp(2.5rem, 7vw, 4.5rem); padding-bottom: var(--section-gap); }
  /* Two rows: name + role (row 1), then bio + photo (row 2). Placing the photo
     in row 2 aligns its top edge with the top of the bio text. The row gap
     supplies the space between the role and the bio. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 13rem);
    column-gap: clamp(1.75rem, 5vw, 2.75rem);
    row-gap: 1.6rem;
    align-items: start;
  }
  .hero-head { grid-column: 1; grid-row: 1; min-width: 0; }
  .hero-body { grid-column: 1; grid-row: 2; min-width: 0; }

  .location {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .pin { font-size: 0.95em; }

  .name {
    font-size: clamp(2.25rem, 6vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .role {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .bio { text-align: justify; }
  .bio p + p { margin-top: 1rem; }

  .socials {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.6rem;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--ink);
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    transition: color 0.18s var(--ease), background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .social :global(.icon) { font-size: 1.15rem; color: var(--brand, var(--accent)); }
  /* Brand colours (label + icon on hover; icon fill for the monochrome marks).
     Kept in CSS rather than an inline style so the CSP needs no inline-style
     allowance — keyed off data-brand set in the template. */
  .social[data-brand="scholar"] { --brand: #4285F4; }
  .social[data-brand="github"] { --brand: #24292F; }
  .social[data-brand="huggingface"] { --brand: #FF9D00; }
  .social[data-brand="linkedin"] { --brand: #0A66C2; }
  /* HF mark now fills its (cropped) viewBox, so it only needs a small bump to
     stand as tall as the single-path marks. Row stays vertically centred. */
  .social :global(.icon.icon-logo) { font-size: 1.3rem; }
  .social-label {
    font-size: 0.9rem;
    font-variant-caps: small-caps;
    font-synthesis: small-caps;
    letter-spacing: 0.03em;
  }
  .social:hover { color: var(--brand, var(--accent)); background: var(--wash); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) {
    .social { transition: color 0.18s var(--ease), background 0.18s var(--ease); }
    .social:hover { transform: none; }
  }

  .hero-photo {
    grid-column: 2;
    grid-row: 2;
    position: sticky;
    top: 5rem;
  }
  /* <Picture> emits a <picture><img>… wrapper (component output, so :global). */
  .hero-photo :global(picture) { display: block; }
  .hero-photo :global(img) {
    width: 100%;
    /* height:auto overrides the intrinsic width/height attributes so the square
       aspect-ratio (not the 640px height hint) drives the box. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--wash);
    box-shadow: 0 20px 45px -24px rgba(0, 66, 37, 0.4);
  }

  @media (max-width: 720px) {
    /* Single column: the blocks stack and the photo floats to the top, all
       centre-aligned. The photo keeps its full (square) framing — same size as
       desktop rather than the old shrunk crop. */
    .hero-grid { grid-template-columns: 1fr; row-gap: 1.25rem; }
    .hero-head, .hero-body, .hero-photo { grid-column: auto; grid-row: auto; }
    .hero-photo {
      position: static;
      order: -1;
      justify-self: center;
    }
    .hero-photo :global(img) { width: min(13rem, 55vw); }
    .hero-head { text-align: center; }
    .location { justify-content: center; }
  }
</style>
